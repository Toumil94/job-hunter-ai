# =============================================================================
# 🔐 VARIABLES D'ENVIRONNEMENT - Copie ce fichier en .env et remplis tes clés
# =============================================================================
# cp .env.example .env

# IA : une seule clé suffit.
# Groq, gratuit et sans carte bancaire (https://console.groq.com/keys) — utilisé en priorité
GROQ_API_KEY=gsk_xxxxx
# Claude, payant (https://console.anthropic.com/) — utilisé si GROQ_API_KEY est absent
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# Adzuna API (https://developer.adzuna.com/)
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key

# Jooble API GRATUIT (https://jooble.org/api/about)
# Agrège LinkedIn, JobUp, jobs.ch, Indeed et des centaines d'autres sites
JOOBLE_API_KEY=your_jooble_api_key

# Gmail - Utilise un App Password !
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_SENDER=ton.email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECIPIENT=ton.email@gmail.com

# Optional: LinkedIn cookies (pour le scraping - avancé)
# LI_AT_COOKIE=your_linkedin_cookie
